# Omit MAB_SESSION_TOKEN to generate a random token on each launch.
# Copy the token from the JSON handshake into Swagger's Authorize dialog.
MAB_HOST=127.0.0.1
MAB_PORT=49321
MAB_DATA_ROOT=.music-annotation-data
MAB_MODEL_ROOT=models
MAB_VENDOR_ROOT=vendor
MAB_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
MAB_AUTO_LOAD_PROVIDER=clap_music
MAB_MODEL_DOWNLOAD_SOURCE=modelscope
MAB_AUTO_LOAD_DEVICE=auto
# First launch downloads CLAP weights and its text encoder (internet required).
MAB_AUTO_LOAD_ALLOW_DOWNLOAD=true
# Optional Essentia DEAM regression; native Windows C++ or Linux/macOS Python.
# start.cmd / start.command automatically prepare and verify the 29 features.
MAB_ESSENTIA_SETUP=auto
# Default startup also prepares and verifies VA weights; --basic skips VA weights.
# DEAM weights: CC BY-NC-SA 4.0 (non-commercial). Set false to skip automatic VA setup.
MAB_ESSENTIA_SETUP_MOOD=true
# OMR runs in an isolated Python 3.12 environment, prepared on first image/PDF import.
MAB_OMR_AUTO_INSTALL=true
# Optional preinstalled HOMR 0.7 Python environment instead of automatic setup:
# MAB_OMR_PYTHON=.tools/homr/Scripts/python.exe
# MAB_OMR_TIMEOUT_SECONDS=1800
# To disable all automatic Essentia setup explicitly: MAB_ESSENTIA_SETUP=off
# MAB_ESSENTIA_NATIVE_EXECUTABLE=build/essentia/Release/essentia-worker.exe
# MAB_ESSENTIA_NATIVE_TIMEOUT_SECONDS=1800
# MAB_MOOD_EMBEDDING_GRAPH=models/essentia/msd-musicnn-1.pb
# MAB_MOOD_REGRESSION_GRAPH=models/essentia/deam-msd-musicnn-2.pb
