{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/music-annotation/project.schema.json",
  "title": "Music Annotation Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "name", "database", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projectId": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 5000, "default": "" },
    "database": { "type": "string", "const": "project.sqlite3" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "activeTaxonomyVersion": { "type": ["string", "null"] },
    "activeModelVersion": { "type": ["string", "null"] },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeUnit": { "enum": ["samples", "seconds"], "default": "samples" },
        "reviewPolicy": { "enum": ["review-first", "confidence-auto"], "default": "review-first" },
        "highConfidenceAuditRate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.05 },
        "defaultContextSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30, "default": 4 }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Namespaced non-authoritative extension metadata."
    }
  }
}
